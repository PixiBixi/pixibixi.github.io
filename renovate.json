{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "schedule:daily"],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "Theme overrides in overrides/partials/ and stylesheets/materialx.css track MaterialX: review every update visually",
      "matchPackageNames": ["mkdocs-materialx"],
      "automerge": false
    }
  ]
}
